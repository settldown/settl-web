---
import type { GetStaticPaths } from "astro";
import LandingSections from "../../components/sections/LandingSections.astro";
import { audiences, type Audience } from "../../data/audiences";
import { heroLead, homeNavCta, type HeroContent } from "../../data/home";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (() =>
  audiences.map((audience) => ({
    params: { audience: audience.slug },
    props: { audience },
  }))) satisfies GetStaticPaths;

interface Props {
  audience: Audience;
}

const { audience } = Astro.props;
const hero: HeroContent = {
  eyebrow: audience.label,
  heading: audience.headline,
  lead: audience.lead ?? heroLead,
};
---

<BaseLayout {...audience.meta} tone="lime" navCta={homeNavCta}>
  <LandingSections hero={hero} items={audience.items} />
</BaseLayout>
