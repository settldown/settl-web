---
import { aboutHero } from "../../data/about";
import Section from "../layout/Section.astro";
import PhotoPlaceholder from "../ui/PhotoPlaceholder.astro";
import SplitLayout from "../ui/SplitLayout.astro";

const content = aboutHero;
---

<Section tone="beige" space="compact">
  <SplitLayout align="start">
    <div class="copy">
      <h1>{content.heading}</h1>
      <p class="strong">{content.strong}</p>
      <p>{content.text}</p>
    </div>
    <PhotoPlaceholder slot="end" {...content.photo} eager />
  </SplitLayout>
</Section>

<style>
  .copy {
    display: grid;
    gap: var(--space-5);
  }

  .strong {
    font-size: var(--text-lead);
    font-weight: var(--weight-bold);
  }
</style>
