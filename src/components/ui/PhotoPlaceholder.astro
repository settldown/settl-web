---
import { Image, inferRemoteSize } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { PhotoRatio } from "../../data/types";
import placeholder from "../../assets/placeholder.jpg";
import { cdnUrl } from "../../data/cdn";

interface Props {
  /** Describes the real photo that belongs here. */
  label?: string;
  /** Pass the real photo once it exists. */
  src?: ImageMetadata;
  /** Or the file name of the real photo on our CloudFront distribution. */
  file?: string;
  /** Alt text for the real photo. Placeholders are decorative. */
  alt?: string;
  ratio?: PhotoRatio;
  sizes?: string;
  eager?: boolean;
}

const {
  label = "Photo",
  src: localSrc,
  file,
  alt = "",
  ratio = "square",
  sizes = "(min-width: 1280px) 640px, (min-width: 768px) 50vw, 100vw",
  eager = false,
} = Astro.props;

const width = 1920;
const remoteSrc = localSrc ? undefined : cdnUrl(file);
// Remote photos need a height too, so Astro can resize them.
const remoteSize = remoteSrc ? await inferRemoteSize(remoteSrc) : undefined;
const image =
  remoteSrc && remoteSize
    ? {
        src: remoteSrc,
        width,
        height: Math.round((width * remoteSize.height) / remoteSize.width),
      }
    : { src: localSrc ?? placeholder, width };
const isReal = Boolean(localSrc || remoteSize);
---

<Image
  {...image}
  alt={isReal ? alt : ""}
  widths={[400, 640, 960, 1280, 1920]}
  sizes={sizes}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  class:list={["photo", `photo--${ratio}`]}
  data-photo-needed={isReal ? undefined : label}
/>

<style>
  .photo {
    width: 100%;
    background: var(--color-placeholder);
    object-fit: cover;
  }

  .photo--hero {
    aspect-ratio: 20 / 21;
  }

  .photo--portrait {
    aspect-ratio: 5 / 6;
  }

  .photo--square {
    aspect-ratio: 1;
  }

  .photo--banner {
    aspect-ratio: 21 / 8;
    min-height: 12rem;
  }
</style>
