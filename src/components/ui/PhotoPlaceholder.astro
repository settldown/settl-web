---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { PhotoRatio } from "../../data/types";
import placeholder from "../../assets/placeholder.jpg";

interface Props {
  /** Describes the real photo that belongs here. */
  label?: string;
  /** Pass the real photo once it exists. */
  src?: ImageMetadata;
  /** Alt text for the real photo. Placeholders are decorative. */
  alt?: string;
  ratio?: PhotoRatio;
  sizes?: string;
  eager?: boolean;
}

const {
  label = "Photo",
  src,
  alt = "",
  ratio = "square",
  sizes = "(min-width: 1280px) 640px, (min-width: 768px) 50vw, 100vw",
  eager = false,
} = Astro.props;
---

<Image
  src={src ?? placeholder}
  alt={src ? alt : ""}
  width={1920}
  widths={[400, 640, 960, 1280, 1920]}
  sizes={sizes}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  class:list={["photo", `photo--${ratio}`]}
  data-photo-needed={src ? undefined : label}
/>

<style>
  .photo {
    width: 100%;
    background: var(--color-placeholder);
    object-fit: cover;
  }

  .photo--hero {
    aspect-ratio: 20 / 21;
  }

  .photo--portrait {
    aspect-ratio: 5 / 6;
  }

  .photo--square {
    aspect-ratio: 1;
  }

  .photo--banner {
    aspect-ratio: 21 / 8;
    min-height: 12rem;
  }
</style>
