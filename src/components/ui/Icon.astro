---
import type { IconName } from "../../data/types";

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "calendar" && (
      <>
        <rect x="3.5" y="5" width="17" height="15" rx="2" />
        <path d="M3.5 10h17M8 3v4M16 3v4" />
      </>
    )
  }
  {name === "check" && <path d="M4.5 12.5l5 5 10-11" />}
  {
    name === "instagram" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <path d="M17.5 6.5h.01" />
      </>
    )
  }
  {
    name === "x" && (
      <path
        class="filled"
        d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.45 21H2.38l7.17-8.2L2 3h6.33l4.37 5.77L17.75 3zm-1.08 16.2h1.7L7.4 4.73H5.58L16.67 19.2z"
      />
    )
  }
</svg>

<style>
  .icon {
    flex: none;
    width: var(--icon-size);
    height: var(--icon-size);
  }

  .filled {
    fill: currentColor;
    stroke: none;
  }
</style>
