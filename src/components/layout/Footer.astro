---
import { site } from "../../data/site";
import Icon from "../ui/Icon.astro";
import Logo from "../ui/Logo.astro";

interface Props {
  /** Draw a line above the footer when it sits on the same color. */
  divider?: boolean;
}

const { divider = false } = Astro.props;
---

<footer class="tone-beige">
  <div class:list={["container", "inner", { divider }]}>
    <div class="brand">
      <Logo size="large" link={false} />
      <p>{site.tagline}</p>
    </div>
    <div class="contact">
      <a class="email" href={site.emailHref}>{site.email}</a>
      <ul class="socials" role="list">
        {
          site.socials.map((social) => (
            <li>
              <a
                href={social.href}
                aria-label={social.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name={social.icon} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--section-pad-compact);
  }

  .divider {
    border-top: var(--border-thin) solid var(--color-divider);
  }

  .brand p {
    font-size: var(--text-small);
  }

  .contact {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  @media (min-width: 40rem) {
    .contact {
      justify-items: end;
    }
  }

  .socials {
    display: flex;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: var(--tap-target);
    height: var(--tap-target);
    border: var(--border-field) solid var(--color-ink);
    border-radius: var(--radius-pill);
    transition: background-color 0.15s ease;
  }

  .socials a:hover {
    background: var(--color-ink);
    color: var(--color-beige);
  }

  .email {
    font-family: var(--font-heading);
    font-size: var(--text-footer-email);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-snug);
    text-decoration: none;
  }

  .email:hover {
    text-decoration: underline;
  }
</style>
